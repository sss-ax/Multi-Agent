 Solution: def min_Swaps(str1, str2):
    if str1.count('1') != str2.count('1'):
        return -1
    n = len(str1)
    diff_indices = []
    for i in range(n):
        if str1[i] != str2[i]:
            diff_indices.append(i)
    if not diff_indices:
        return 0
    swaps = 0
    i = 0
    while i < len(diff_indices) - 1:
        j = i + 1
        while j < len(diff_indices) and diff_indices[j] - diff_indices[j - 1] == 1:
            j += 1
        swaps += (j - i - 1) // 2
        i = j
    return swaps.
 Test: def check():
