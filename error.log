 Solution: def count_vowels(test_str):
    vowels = set('aeiouAEIOU')
    count = 0
    if test_str[0] in vowels and (len(test_str) == 1 or test_str[1] not in vowels):
        count += 1
    for i in range(1, len(test_str) - 1):
        if test_str[i - 1] in vowels or test_str[i + 1] in vowels:
            count += 1
    if test_str[-1] in vowels and (len(test_str) == 1 or test_str[-2] not in vowels):
        count += 1
    return count.
