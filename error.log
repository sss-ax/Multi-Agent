 Solution: def re_arrange_array(arr, n):
    first_n_elements = arr[:n]
    negatives = [x for x in first_n_elements if x < 0]
    positives = [x for x in first_n_elements if x >= 0]
    rearranged = [None] * n
    for i in range(len(negatives)):
        rearranged[i] = negatives[i]
    for i in range(len(positives)):
        rearranged[len(negatives) + i] = positives[i]
    for i in range(n):
        arr[i] = rearranged[i]
    return arr.
