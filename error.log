 Solution: def max_sum_increasing_subseq(a, n, index, k):
    if k >= n:
        return -1
    dp = [0] * n
    dp[0] = a[0]
    for i in range(1, n):
        dp[i] = a[i]
        for j in range(i):
            if a[j] < a[i]:
                dp[i] = max(dp[i], dp[j] + a[i])
    max_sum = 0
    for i in range(index):
        if a[i] < a[index]:
            max_sum = max(max_sum, dp[i])
    return max_sum + a[k]
