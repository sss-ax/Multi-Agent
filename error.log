def poly(xs: list, x: float):
    return sum(coeff * (x ** i) for i, coeff in enumerate(xs))

def find_zero(xs: list):
    if len(xs) % 2 != 0:
        raise ValueError('The length of the coefficient list must be even.')
    a = xs[0]
    b = xs[1]
    c = xs[2]
    d = xs[3]
    if abs(a) > abs(b) and abs(a) > abs(c) and (abs(a) > abs(d)):
        p = (c ** 2 - 3 * a * b) / 9 * a ** 2
        q = (2 * c ** 3 - 9 * a * b * c + 27 * a ** 2 * d) / 54 * a ** 3
        delta = q ** 2 + 4 * p ** 3 / 27
        if delta > 0:
            r = (-q / 2 + math.sqrt(delta)) ** (1 / 3)
            s = (-q / 2 - math.sqrt(delta)) ** (1 / 3)
            x1 = -r - s - c / (3 * a)
            return x1
        elif delta == 0:
            r = (-q / 2) ** (1 / 3)
            x1 = -2 * r - c / (3 * a)
            return x1
        else:
            theta = math.acos(-q / (2 * math.sqrt(-p ** 3 / 27)))
            x1 = 2 * math.sqrt(-p / 3) * math.cos(theta / 3) - c / (3 * a)
            return x1
    else:
        raise ValueError('The largest non-zero coefficient is not the first one.').
