 Solution: from typing import List
def combinations_list(list1: List[int]) -> List[List[int]]:
    """
    Generate all possible combinations of the elements of a given list.
    
    Args:
    list1: A list of integers.
    
    Returns:
    A list of lists, where each inner list is a unique combination of elements from the input list.
    """
    if not list1:
        return [[]]
    first_element = list1[0]
    rest_elements = list1[1:]
    combinations_without_first = combinations_list(rest_elements)
    combinations_with_first = [[first_element] + combo for combo in combinations_without_first]
    all_combinations = combinations_without_first + combinations_with_first
    return all_combinations.
