 Solution: def all_Bits_Set_In_The_Given_Range(n, l, r):
    """
    Check if all bits in the range [l, r] of the integer n are set (i.e., 1).

    :param n: Integer number to check bits in.
    :param l: Left boundary of the bit range (1-based index).
    :param r: Right boundary of the bit range (1-based index).
    :return: True if all bits in the range [l, r] are set, False otherwise.
    """
    mask = (1 << r) - 1 ^ (1 << l - 1) - 1
    mask = ~mask
    mask >>= l - 1
    return n & mask == mask.
