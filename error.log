 Solution: def min_Jumps(steps, d):
    """
    Calculate the minimum number of jumps of given length required to reach a point of form (d, 0) from origin in a 2D plane.
    
    :param steps: int - The length of each jump.
    :param d: int - The target distance on the x-axis.
    :return: int - The minimum number of jumps required to reach the target. Returns -1 if it's not possible.
    """
    if d < 0:
        return -1
    if d == 0:
        return 0
    full_jumps = d // steps
    remaining_distance = d % steps
    if remaining_distance == 0:
        return full_jumps
    return full_jumps + 1.
