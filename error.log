 Solution: def find_First_Missing(array, start=0, end=None):
    """
    Finds the smallest missing number in a sorted list of natural numbers.
    
    :param array: List of sorted natural numbers
    :param start: Starting index for the search (default is 0)
    :param end: Ending index for the search (default is None, which means the last index of the array)
    :return: The smallest missing number
    """
    if end is None:
        end = len(array) - 1
    if start > end:
        return start
    while start <= end:
        mid = (start + end) // 2
        if array[mid] == mid + array[0]:
            start = mid + 1
        else:
            end = mid - 1
    return start.
